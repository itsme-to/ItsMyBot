{
  "name": "itsmybot",
  "version": "3.11.6",
  "description": "",
  "main": "build/index.js",
  "private": true,
  "workspaces": [
    "src/addons/*"
  ],
  "scripts": {
    "make:addon": "node ./build/core/tools/makeAddon.js",
    "tools:translate": "node --env-file=.env ./build/core/tools/translate/index.js",
    "build:clean": "rm -rf ./build",
    "build:itsmybot": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "build:copy": "node ./build/core/tools/copyBuildAssets.js",
    "build": "npm run build:clean && npm run build:itsmybot && npm run build:copy && echo '[ItsMyBot] Build completed successfully!'",
    "start": "node ./build/index.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsme-to/ItsMyBot"
  },
  "author": "@itsme.to",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/itsme-to/ItsMyBot/issues"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "reflect-metadata": "^0.2.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vscode/sqlite3": "^5.1.14-vscode",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "discord.js": "^14.27.0",
    "filtrex": "^3.1.0",
    "mariadb": "^3.5.3",
    "mysql2": "^3.23.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "@vscode/sqlite3": true,
    "fsevents": true
  }
}
